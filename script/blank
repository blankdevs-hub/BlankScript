getgenv().supported = {
    [3623096087] = "https://raw.githubusercontent.com/blankdevs-hub/BlankScript/refs/heads/main/Script/Muscle%20Legends",--Muscle Legends
}

local placeId = game.PlaceId
local scriptUrl = getgenv().supported[placeId]

if not scriptUrl then
    pcall(function()
        game:GetService("Players").LocalPlayer:Kick("脚本不支持当前游戏 Q群1126600419")
    end)
    return
end

pcall(function()
    loadstring(game:HttpGet(scriptUrl))()
end)
